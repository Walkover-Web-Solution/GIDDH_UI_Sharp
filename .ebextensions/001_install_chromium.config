files:
    "/tmp/install_chromium.sh":
        mode: 700
        owner: root
        group: root
        content: |
            set -e
            # Bucket must exist and contain the pinned RPM (see deploy docs / team runbook).
            # Override with EB env var EB_DEPS_S3_BUCKET if needed.
            S3_BUCKET="${EB_DEPS_S3_BUCKET:-giddh-template-eb-deps}"
            S3_PREFIX="eb-deps"
            CHROME_VERSION="154.0.8037.97-1"
            CHROME_RPM="google-chrome-stable-${CHROME_VERSION}.x86_64.rpm"
            S3_URI="s3://${S3_BUCKET}/${S3_PREFIX}/${CHROME_RPM}"

            echo "[INFO] Downloading Chrome ${CHROME_VERSION} from ${S3_URI}"
            cd /tmp
            rm -f "${CHROME_RPM}"
            aws s3 cp "${S3_URI}" "./${CHROME_RPM}"

            if [ ! -s "${CHROME_RPM}" ]; then
              echo "[ERROR] Chrome RPM download from S3 failed: ${S3_URI}"
              exit 1
            fi

            # Downgrade/replace if a newer Chrome (e.g. 155) is already installed
            yum remove -y google-chrome-stable || true
            yum install -y "./${CHROME_RPM}"

            # Prevent yum from upgrading Chrome back to latest stable
            if [ -f /etc/yum.repos.d/google-chrome.repo ]; then
              sed -i 's/^enabled=1/enabled=0/' /etc/yum.repos.d/google-chrome.repo || true
            fi
            if ! grep -q 'exclude=google-chrome-stable' /etc/dnf/dnf.conf 2>/dev/null; then
              echo 'exclude=google-chrome-stable' >> /etc/dnf/dnf.conf
            fi
            if [ -f /etc/yum.conf ] && ! grep -q 'exclude=google-chrome-stable' /etc/yum.conf; then
              echo 'exclude=google-chrome-stable' >> /etc/yum.conf
            fi

            google-chrome-stable --version
            google-chrome-stable --version | grep -q '154.0.8037.97'
container_commands:
    00_run_command:
        command: "/tmp/install_chromium.sh"
