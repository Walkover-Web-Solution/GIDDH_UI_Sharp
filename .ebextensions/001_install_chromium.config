files:
    "/tmp/install_chromium.sh":
        mode: 700
        owner: root
        group: root
        content: |
            set -e
            CHROME_VERSION="154.0.8037.97-1"
            CHROME_RPM="google-chrome-stable-${CHROME_VERSION}.x86_64.rpm"
            CHROME_ZIP="${CHROME_RPM}.zip"
            EXTRACT_DIR="/tmp/chrome-local-install"
            ASSEMBLED_ZIP="/tmp/${CHROME_ZIP}"

            echo "[INFO] Installing Chrome ${CHROME_VERSION} from local deps parts (no internet download)"

            # Publish staging may be cwd; also try common EB paths
            PARTS=""
            for base in "." "/var/app/staging" "/var/app/current"; do
              if ls ${base}/deps/${CHROME_ZIP}.part* >/dev/null 2>&1; then
                PARTS=$(ls ${base}/deps/${CHROME_ZIP}.part* | sort)
                echo "[INFO] Found Chrome parts under ${base}/deps/"
                break
              fi
            done

            if [ -z "${PARTS}" ]; then
              echo "[ERROR] Chrome zip parts not found: deps/${CHROME_ZIP}.part*"
              echo "[ERROR] Ensure deps/ is in the deploy package (csproj Content Include + CodeBuild copy)."
              ls -la . deps/ /var/app/staging/deps/ 2>/dev/null || true
              exit 1
            fi

            rm -f "${ASSEMBLED_ZIP}"
            cat ${PARTS} > "${ASSEMBLED_ZIP}"

            yum install -y unzip >/dev/null 2>&1 || true
            rm -rf "${EXTRACT_DIR}"
            mkdir -p "${EXTRACT_DIR}"
            unzip -o "${ASSEMBLED_ZIP}" -d "${EXTRACT_DIR}"

            if [ ! -s "${EXTRACT_DIR}/${CHROME_RPM}" ]; then
              echo "[ERROR] RPM missing after unzip: ${CHROME_RPM}"
              ls -la "${EXTRACT_DIR}" || true
              exit 1
            fi

            # Downgrade/replace if a newer Chrome (e.g. 155) is already installed
            yum remove -y google-chrome-stable || true
            yum install -y "${EXTRACT_DIR}/${CHROME_RPM}"

            # Prevent yum from upgrading Chrome back to latest stable
            if [ -f /etc/yum.repos.d/google-chrome.repo ]; then
              sed -i 's/^enabled=1/enabled=0/' /etc/yum.repos.d/google-chrome.repo || true
            fi
            if ! grep -q 'exclude=google-chrome-stable' /etc/dnf/dnf.conf 2>/dev/null; then
              echo 'exclude=google-chrome-stable' >> /etc/dnf/dnf.conf
            fi
            if [ -f /etc/yum.conf ] && ! grep -q 'exclude=google-chrome-stable' /etc/yum.conf; then
              echo 'exclude=google-chrome-stable' >> /etc/yum.conf
            fi

            rm -rf "${EXTRACT_DIR}" "${ASSEMBLED_ZIP}"

            google-chrome-stable --version
            google-chrome-stable --version | grep -q '154.0.8037.97'
container_commands:
    00_run_command:
        command: "/tmp/install_chromium.sh"
