@model InvoiceData.Root;
@using InvoiceData;
@using System.Collections.Generic;

@functions {
    /* Label markup honouring Label / SecondaryLabel, printed side by side. */
    public RazorLight.Text.IRawString Lbl(Setting setting)
    {
        return LabelRenderer.Html(setting, Model?.LabelDisplay, LabelLayout.Inline);
    }

    /* Table header label markup, both languages stacked vertically (top to bottom). */
    public RazorLight.Text.IRawString LblStack(Setting setting)
    {
        return LabelRenderer.Html(setting, Model?.LabelDisplay, LabelLayout.Stacked);
    }

    /* Plain text label, use it for comparisons, emptiness checks and string interpolation. */
    public string LblText(Setting setting)
    {
        return LabelRenderer.Text(setting, Model?.LabelDisplay);
    }

    /* Markup for a value sent in both languages, one paragraph per language. */
    public RazorLight.Text.IRawString LblValue(string? primary, string? secondary, string? cssClass = null)
    {
        return LabelRenderer.HtmlBlocks(primary, secondary, Model?.LabelDisplay, "p", cssClass);
    }
}

<footer id="footer" style="@(Model?.ShowSectionsInline == true ? "flex-grow: 1" : "")">
    <table class="page-break-inside-avoid h-100">
        <tbody>
            <tr>
                <td class="p-0 vertical-align-bottom" width="33%">
                    <table>
                        <tbody>
                            @if (Model?.Settings?.ShowNotesAtLastPage?.Display != true)
                            {
                                @if (Model?.Settings?.Message1?.Display == true)
                                {
                                    @if (!string.IsNullOrEmpty(Model?.Message1) || !string.IsNullOrEmpty(Model?.SecondaryMessage1))
                                    {
                                        <tr>
                                            <td>
                                                @LblValue(Model?.Message1, Model?.SecondaryMessage1, "text-wrap-pre")
                                            </td>
                                        </tr>
                                    }
                                }
                                @if (Model?.Settings?.ShowMessage2?.Display == true && !string.IsNullOrEmpty(Model?.Message2))
                                {
                                    <tr>
                                        <td>
                                            <p class="text-wrap-pre">@Model?.Message2</p>
                                        </td>
                                    </tr>
                                }
                            }
                            @if (Model?.Settings?.Thanks?.Display == true)
                            {
                                <tr>
                                    <td>
                                        <strong class="color-primary">@Lbl(Model?.Settings?.Thanks)</strong>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </td>
                <td class="p-0 vertical-align-bottom text-center" width="33%">
                    @if (!string.IsNullOrEmpty(Model?.SealPath))
                    {
                        <img src="@Model.SealPath"
                            height="100px" width="180px" />
                    }
                </td>
                <td class="vertical-align-bottom text-center" width="33%">
                    @if (Model?.Settings?.Slogan?.Display == true || Model?.Settings?.ImageSignature?.Display == true)
                    {
                        <div class="border-bottom" style="padding-bottom: 5px;">
                            @if (Model?.Settings?.ImageSignature?.Display == true && !string.IsNullOrEmpty(Model?.ImageSignature))
                            {
                                <figure class="m-0">
                                    <img src="@Model.ImageSignature" height="60px" width="auto" class="signature-image" />
                                </figure>
                            } else if (Model.Settings.Slogan.Display == true && !string.IsNullOrEmpty(LblText(Model.Settings.Slogan)))
                            {
                                <p>@Lbl(Model.Settings.Slogan)</p>
                            }
                        </div>
                    }
                    @if (Model?.Settings?.TextUnderSlogan?.Display == true)
                    {
                        <p class="text-under-signature mr-t1">@Lbl(Model?.Settings?.TextUnderSlogan)</p>
                    }
                </td>
            </tr>
            <tr>
                <td colspan="100%" class="px-0">
                    <hr class="color-primary" />
                </td>
            </tr>
            <tr>
                <td colspan="100%" class="text-center">
                    @if (Model?.Settings?.FooterCompanyName?.Display == true)
                    {
                        <p class="font-weight-500">@Lbl(Model.Settings.FooterCompanyName)</p>
                    }
                    @if (Model?.Settings?.CompanyAddress?.Display == true)
                    {
                        <address>@Lbl(Model?.Settings?.CompanyAddress)</address>
                    }
                </td>
            </tr>
        </tbody>
    </table>
</footer>
