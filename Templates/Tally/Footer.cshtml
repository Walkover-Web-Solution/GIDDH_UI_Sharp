@model InvoiceData.Root;
@using InvoiceData;
@using System.Collections.Generic;

@functions {
    private readonly Dictionary<string, Setting> _settingCache = new Dictionary<string, Setting>();

    public Setting GetSetting(string settingName)
    {
        if (!_settingCache.TryGetValue(settingName, out var setting))
        {
            setting = Model.Settings?.GetType().GetProperty(settingName)?.GetValue(Model.Settings) as Setting;
            _settingCache[settingName] = setting ??= new Setting();
        }
        return setting;
    }

    /* Label markup honouring Label / SecondaryLabel, printed side by side. */
    public RazorLight.Text.IRawString GetLabel(string settingName)
    {
        var setting = GetSetting(settingName);
        return LabelRenderer.Html(setting?.Display == true ? setting : null, Model?.LabelDisplay, LabelLayout.Inline);
    }

    /* Table header label markup, both languages stacked vertically (top to bottom). */
    public RazorLight.Text.IRawString GetHeaderLabel(string settingName)
    {
        var setting = GetSetting(settingName);
        return LabelRenderer.Html(setting?.Display == true ? setting : null, Model?.LabelDisplay, LabelLayout.Stacked);
    }

    /* Plain text label, use it for comparisons, emptiness checks and string interpolation. */
    public string GetLabelText(string settingName)
    {
        var setting = GetSetting(settingName);
        return setting?.Display == true ? LabelRenderer.Text(setting, Model?.LabelDisplay) : string.Empty;
    }

    public bool GetDisplayStatus(string settingName)
    {
        return GetSetting(settingName)?.Display == true;
    }

    /* Markup for a value sent in both languages, one paragraph per language. */
    public RazorLight.Text.IRawString LblValue(string? primary, string? secondary, string? cssClass = null)
    {
        return LabelRenderer.HtmlBlocks(primary, secondary, Model?.LabelDisplay, "p", cssClass);
    }
}

<footer id="footer" style="@(Model?.ShowSectionsInline == true ? "flex-grow: 1" : "")">
    <table class="page-break-inside-avoid h-100">
        <tbody>
            <tr>
                <td class="p-0 border-none border-bottom vertical-align-bottom @(Model?.ShowSectionsInline == true ? "border-left border-right" : "")">
                    <table style="margin-top: 50px;">
                        <tbody>
                            @if (GetDisplayStatus("ShowMessage2") && !string.IsNullOrEmpty(GetLabelText("ShowMessage2")))
                            {
                                <tr>
                                    <td class="border-none" colspan="2">
                                        <u>@GetLabel("ShowMessage2")</u>
                                        <p class="margin-0 text-wrap-pre">@Model?.Message2</p>
                                    </td>
                                </tr>
                            }
                            <tr>
                                <td class="p-0 border-none vertical-align-bottom">
                                    <table class="mr-t1">
                                        <tr>
                                            <td class="border-none border-right" width="50%" rowspan="2">
                                                @if (GetDisplayStatus("Message1"))
                                                {
                                                    <u>@GetLabel("Message1")</u>
                                                    @LblValue(Model?.Message1, Model?.SecondaryMessage1, "margin-0 text-wrap-pre")
                                                }
                                            </td>
                                            @if (GetDisplayStatus("FooterCompanyName"))
                                            {
                                                <td class="border-none border-top" width="50%">
                                                    <p class="text-right pd-r1">@GetLabel("FooterCompanyName")</p>
                                                </td>
                                            }
                                        </tr>
                                        
                                        @if (GetDisplayStatus("TextUnderSlogan") || GetDisplayStatus("ImageSignature") || Model?.DigitalSignature == true)
                                        {
                                            <tr>
                                                <td class="border-none pd-r1 text-right">
                                                    @if (GetDisplayStatus("ImageSignature") && !string.IsNullOrEmpty(Model?.ImageSignature))
                                                    {
                                                    <div>
                                                        <img src="@Model.ImageSignature" height="60px" width="auto" class="signature-image" />
                                                    </div>
                                                    }

                                                    @if (GetDisplayStatus("TextUnderSlogan"))
                                                    {
                                                        @GetLabel("TextUnderSlogan")
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </table>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        </tbody>
    </table>
</footer>
