@model GiddhTemplate.Models.CertificateRequest
<section class="content">
    <p class="program">GIDDH Certified — Partner &amp; Accountant Program</p>
    <h1>CERTIFICATE</h1>
    <div class="subtitle">OF COMPLETION</div>
    <div class="divider"></div>
    <p class="presented">Proudly presented to</p>
    <p class="recipient">@Model.name</p>
    <p class="completion">
        For successfully completing the program with a score of @(Model.percentage)%
    </p>
</section>
